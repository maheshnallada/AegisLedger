# ==============================================================================
# AegisLedger Environment Configuration
# ==============================================================================

# Application Meta
APP_NAME=AegisLedger
APP_VERSION=1.0.0
DEBUG=False

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------

# Option 1: Local SQLite (Default for zero-setup local development and tests)
DATABASE_URL=sqlite:///./aegis_ledger.db

# Option 2: Supabase PostgreSQL (Production / AWS Deployment)
# In your Supabase Dashboard: Project Settings -> Database -> Connection string
# 
# A) Connection Pooling (Recommended for serverless, AWS Lambda, App Runner, or ECS)
#    Port 6543 with PgBouncer transaction pooling mode:
#    DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# B) Direct Connection (Standard PostgreSQL session mode)
#    Port 5432:
#    DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
#
# Note: SQLAlchemy 2.0 requires the 'postgresql://' or 'postgresql+psycopg2://' prefix.
# AegisLedger automatically normalizes 'postgres://' into 'postgresql+psycopg2://'.

# Connection Pool Settings (Tuned for Supabase / PostgreSQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300

