# Frontend Environment Variables

# In development (Vite development proxy handles routing to http://localhost:8000)
VITE_API_URL=

# In production / AWS (set to your deployed backend URL, e.g. AWS App Runner or ALB)
# VITE_API_URL=https://api.yourdomain.com
# VITE_API_URL=https://[app-runner-hash].[region].awsapprunner.com

